#!/usr/bin/env ruby
# frozen_string_literal: true

# Measures get_multi and set_multi latency (p50/p95/p99 per call) across
# payload sizes, comparing git refs and the working tree.
#
# Throughput benchmarks (bin/compare_refs) report a median rate; this reports
# the latency distribution of individual multi-key calls, which is what an
# application sees as tail latency. Payload size changes where the time goes:
# small values are dominated by per-key Ruby overhead (request building and
# reply parsing), large values by copying bytes and socket reads.
#
# Each ref's lib/ is exported to a temporary directory and measured in its
# own Ruby process, against dedicated memcached instances. Refs run in
# alternating rounds so machine drift hits each alike; the reported numbers
# are the median across rounds of each round's percentile.
#
# Run with plain ruby, not bundle exec, so this checkout's lib/ doesn't shadow
# the ref being measured. Needs memcached on the PATH.
#
# Usage:
#   bin/multi_latency                       # main vs working tree
#   bin/multi_latency v5.3.3 .              # "." is the working tree
#   SIZES=100,102400 SERVERS=1 bin/multi_latency main .
#
# Environment variables:
#   ROUNDS   - rounds over all the refs (default: 3)
#   SAMPLES  - timed calls per workload per round (default: 300)
#   SIZES    - comma-separated payload sizes in bytes
#              (default: 100,1024,10240,102400,524288)
#   SERVERS  - comma-separated server counts (default: 1,3). 1 takes the
#              single-server fast path, more than 1 the pipelined path.
#   OPS      - comma-separated operations: get_multi,set_multi (default: both)
#   MODE     - raw (raw: true, no serializer or compression) or default
#              (Marshal, compression enabled). Default: raw
#   TARGET   - p95 improvement target in percent, reported per row (default: 20)

require 'json'
require 'rbconfig'
require 'securerandom'
require 'shellwords'
require 'socket'
require 'tmpdir'

# rubocop:disable Style/OneClassPerFile

# Runs the workloads with whichever Dalli is first on the load path
module MultiLatencyWorker
  WARMUP = 20

  # Keys per call, so a call moves a few MB at most
  def self.keys_for(size)
    if size <= 10_240 then 100
    elsif size <= 102_400 then 25
    else 8
    end
  end

  def self.run(ports, sizes, servers_list, ops, samples, mode)
    require 'dalli'
    require 'logger'
    Dalli.logger.level = Logger::ERROR
    results = {}
    servers_list.each do |server_count|
      client = build_client(ports.first(server_count), mode)
      sizes.each do |size|
        keys = Array.new(keys_for(size)) { |i| "ml:#{server_count}:#{size}:#{i}" }
        # Random bytes don't compress, so in default mode compression is tried
        # and kept off by the size check, as for typical binary payloads
        hash = keys.to_h { |k| [k, SecureRandom.random_bytes(size)] }
        client.set_multi(hash, 0)
        ops.each do |op|
          work = op == 'get_multi' ? -> { client.get_multi(keys) } : -> { client.set_multi(hash, 0) }
          check(client, keys, hash) if op == 'get_multi'
          results["#{op} #{server_count}srv #{size}B x#{keys.size}"] = measure(work, samples)
        end
      end
      client.close
    end
    puts JSON.generate(results)
  end

  def self.build_client(ports, mode)
    servers = ports.map { |p| "127.0.0.1:#{p}" }.join(',')
    opts = { silence_marshal_warning: true, value_max_bytes: 2 * 1024 * 1024 }
    if mode == 'raw'
      opts[:raw] = true
      opts[:compress] = false
    end
    Dalli::Client.new(servers, **opts)
  end

  def self.check(client, keys, hash)
    got = client.get_multi(keys)
    return if got.size == keys.size && keys.all? { |k| got[k] == hash[k] }

    abort "get_multi returned wrong values (#{got.size}/#{keys.size} keys)"
  end

  def self.measure(work, samples)
    WARMUP.times { work.call }
    GC.start
    times = Array.new(samples) do
      t = Process.clock_gettime(Process::CLOCK_MONOTONIC)
      work.call
      Process.clock_gettime(Process::CLOCK_MONOTONIC) - t
    end
    times.sort!
    { 'p50' => pct(times, 50), 'p95' => pct(times, 95), 'p99' => pct(times, 99) }
  end

  def self.pct(sorted, pct)
    sorted[((sorted.size - 1) * pct / 100.0).round] * 1_000_000 # microseconds
  end
end

# Exports the refs, starts memcached and runs the workers in rounds
module MultiLatency
  ROOT = File.expand_path('..', __dir__)
  WORKING_TREE = '.'
  WORKER_ENV = { 'RUBYOPT' => nil, 'BUNDLE_GEMFILE' => nil }.freeze

  def self.config
    {
      rounds: Integer(ENV.fetch('ROUNDS', '3')),
      samples: Integer(ENV.fetch('SAMPLES', '300')),
      sizes: ENV.fetch('SIZES', '100,1024,10240,102400,524288'),
      servers: ENV.fetch('SERVERS', '1,3'),
      ops: ENV.fetch('OPS', 'get_multi,set_multi'),
      mode: ENV.fetch('MODE', 'raw'),
      target: Float(ENV.fetch('TARGET', '20'))
    }
  end

  def self.run(refs)
    refs = ['main', WORKING_TREE] if refs.empty?
    cfg = config
    puts "Ruby #{RUBY_VERSION} #{'YJIT ' if defined?(RubyVM::YJIT) && RubyVM::YJIT.enabled?}" \
         "mode=#{cfg[:mode]} rounds=#{cfg[:rounds]} samples=#{cfg[:samples]}"
    Dir.mktmpdir('dalli-latency') do |tmp|
      libs = refs.to_h { |ref| [ref, export_lib(ref, tmp)] }
      results = with_memcached(3) do |ports|
        Array.new(cfg[:rounds]) do |round|
          warn "round #{round + 1}/#{cfg[:rounds]}"
          refs.to_h { |ref| [ref, run_worker(ref, libs[ref], ports, cfg)] }
        end
      end
      report(refs, results, cfg[:target])
    end
  end

  def self.export_lib(ref, tmp)
    return File.join(ROOT, 'lib') if ref == WORKING_TREE

    dir = File.join(tmp, ref.tr('/', '_'))
    Dir.mkdir(dir)
    archive = "git -C #{ROOT.shellescape} archive #{ref.shellescape} lib | tar -x -C #{dir.shellescape}"
    system(archive) || abort("Couldn't export lib/ from #{ref}")
    File.join(dir, 'lib')
  end

  def self.with_memcached(count)
    ports = Array.new(count) { free_port }
    pids = ports.map do |port|
      Process.spawn('memcached', '-p', port.to_s, '-U', '0', '-l', '127.0.0.1', '-m', '1024', '-I', '4m',
                    out: File::NULL, err: File::NULL)
    end
    ports.each { |port| wait_for(port) }
    yield ports
  ensure
    pids&.each do |pid|
      Process.kill(:TERM, pid)
      Process.wait(pid)
    end
  end

  def self.free_port
    server = TCPServer.new('127.0.0.1', 0)
    server.addr[1]
  ensure
    server&.close
  end

  def self.wait_for(port)
    50.times do
      TCPSocket.new('127.0.0.1', port).close
      return
    rescue SystemCallError
      sleep 0.1
    end
    abort "memcached didn't start on port #{port}"
  end

  def self.run_worker(ref, lib, ports, cfg)
    cmd = [WORKER_ENV, RbConfig.ruby, '-W0', '-I', lib, __FILE__, '--worker', ports.join(','),
           cfg[:sizes], cfg[:servers], cfg[:ops], cfg[:samples].to_s, cfg[:mode]]
    output = IO.popen(cmd, &:read)
    abort "Measuring #{ref} failed" unless Process.last_status.success?
    JSON.parse(output.lines.last)
  end

  def self.report(refs, rounds, target)
    base, *others = refs
    merged = refs.to_h { |ref| [ref, median_by_workload(rounds.map { |r| r[ref] })] }
    # Refs are numbered in the columns, as names can share a long prefix
    refs.each_with_index { |r, i| puts "[#{i + 1}] #{r}" }
    header = 'workload (us per call)'.ljust(34) +
             refs.each_index.map { |i|
               format(' %<p50>8s %<p95>8s', p50: "[#{i + 1}] p50", p95: "[#{i + 1}] p95")
             }.join +
             others.each_index.map { |i| format(' %<label>10s', label: "p95 [#{i + 2}]") }.join
    puts header
    merged[base].each_key do |name|
      row = name.ljust(34)
      refs.each do |r|
        row << format(' %<p50>8.0f %<p95>8.0f', p50: merged[r][name]['p50'], p95: merged[r][name]['p95'])
      end
      others.each do |r|
        change = ((merged[r][name]['p95'] / merged[base][name]['p95']) - 1) * 100
        row << format(' %<change>9.1f%%%<mark>s', change: change, mark: -change >= target ? '*' : ' ')
      end
      puts row
    end
    puts "\n* p95 at least #{target.round}% lower than [1] #{base}"
  end

  PERCENTILES = %w[p50 p95 p99].freeze

  def self.median_by_workload(rounds)
    rounds.first.keys.to_h do |name|
      [name, PERCENTILES.to_h { |p| [p, median(rounds.map { |r| r[name][p] })] }]
    end
  end

  def self.median(values)
    sorted = values.sort
    mid = sorted.size / 2
    sorted.size.odd? ? sorted[mid] : (sorted[mid - 1] + sorted[mid]) / 2.0
  end
end

if ARGV.first == '--worker'
  _, ports, sizes, servers, ops, samples, mode = ARGV
  MultiLatencyWorker.run(ports.split(',').map(&:to_i), sizes.split(',').map(&:to_i),
                         servers.split(',').map(&:to_i), ops.split(','), samples.to_i, mode)
else
  MultiLatency.run(ARGV)
end
# rubocop:enable Style/OneClassPerFile
